APP_NAME=VENDRA
APP_ENV=development
APP_VERSION=0.0.14
SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
COOKIE_SECURE=false
SESSION_HOURS=8

# Para abrir o projeto sem Supabase, mantenha true.
# Login demo: admin@demo.local / admin123
DEMO_MODE=true

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# Compatibilidade com integrações antigas. Nas novas instalações, gere o segredo em
# Configurações > Webhooks dentro do VENDRA. Se não usar o endpoint legado, pode ficar vazio.
MAKE_WEBHOOK_SECRET=

# Anexos privados do atendimento
ATTACHMENT_BUCKET=ticket-attachments
ATTACHMENT_MAX_MB=15
ATTACHMENT_VIDEO_MAX_MB=50

# Intervalo da sincronização automática do chat/fila
LIVE_POLL_SECONDS=4

# Claim durável do outbox Make/WhatsApp
INTEGRATION_CLAIM_TTL_SECONDS=120
MAKE_WORKER_NAME=make-whatsapp

# Opcional: sobrescreva o caminho do arquivo local por máquina.
# Padrão Windows: %LOCALAPPDATA%\VENDRA\credentials.local.json
VENDRA_LOCAL_CONFIG=

# Usuários / convites: link compartilhável por padrão; SMTP opcional.
INVITATION_DELIVERY=link
PUBLIC_APP_URL=http://127.0.0.1:8010
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false

# Templates da Meta — não use o webhook Make de template fixo neste recurso.
# Nunca inclua tokens nos ZIPs; configure apenas no ambiente instalado.
META_ACCESS_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v24.0
